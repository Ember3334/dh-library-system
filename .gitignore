# 依赖
node_modules/

# 运行时数据库（自动生成）
data/*.db
data/*.db-shm
data/*.db-wal

# 源资料大文件（本地保留，不入库）
references/

# 日志
*.log
.DS_Store

# 运行态（启动器写入 PID 与日志，不入库）
.runtime/

# 环境变量（管理口令与签名密钥）
.env
data/founder.json

# 静态发布产物
dist-static/

# 管理端上传的媒体文件（内容随本地数据走，不入 git）
public/media/*
!public/media/.gitkeep

# 数据库备份
data/*.bak-*

# WorkBuddy 本地记忆/配置（项目相关，但不入代码库）
.workbuddy/
