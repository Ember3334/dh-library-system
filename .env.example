# 复制为 .env 后按需修改；node server/server.js 会自动读取
# 创始人管理口令（#/manage 登录用）——必改，别用默认值
FOUNDER_PASSCODE=change-me-to-your-secret
# 管理 token 签名密钥——必改，随便一串长随机字符
TOKEN_SECRET=change-me-to-a-long-random-string
# 可选：LLM 工具增强接口（不填则离线规则引擎）
LLM_API_URL=
LLM_API_KEY=
# 端口——一般不用改：启动器会探测 3000 起逐个往上找到空闲端口，
# 只有当这一整段都被别的软件占了才需要手动指定（如 3100）
PORT=3000
